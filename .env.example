# Copy to .env and adjust. All values are optional; defaults are shown.

# ---- Embedding ----
# EMBEDDING_MODEL=BAAI/bge-m3
# EMBEDDING_DEVICE=          # "", "cpu" or "cuda"
# EMBEDDING_BATCH_SIZE=16
# HF_HUB_OFFLINE=1           # after the first download, run fully offline

# ---- Retrieval ----
# TOP_K=5
# MIN_SIMILARITY=0.5

# ---- Ollama ----
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=qwen2.5:3b    # qwen2.5:7b gives better answers if you have >=16 GB RAM
# LLM_TEMPERATURE=0.1
# LLM_NUM_CTX=8192
# OLLAMA_NUM_GPU=            # set 0 to force CPU if Ollama crashes on an old/integrated GPU
